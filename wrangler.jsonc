// Publica o Grove Online na Cloudflare: um Worker que só serve arquivos estáticos.
// Na raiz do repositório:
//   npx wrangler@4.151.3 login    (só na primeira vez; abre o navegador)
//   npx wrangler@4.151.3 deploy
// O que vai para o site está em .assetsignore.
{
  // o Worker que já está no ar é "groveonline", sem hífen: outro nome aqui cria um
  // Worker novo e deixa grove.heybrain.uk apontando para o antigo
  "name": "groveonline",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash"
  },
  // a URL groveonline.heybrain.workers.dev está desligada (04/11/2026): o site
  // atende só no domínio próprio. true aqui a religa no próximo deploy.
  "workers_dev": false,
  // logs no painel: ligado em 04/11/2026; sem esta linha o deploy desliga
  "observability": { "enabled": true },
  "routes": [{ "pattern": "grove.heybrain.uk", "custom_domain": true }]
}
